<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sample_title" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/modeLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:text="@string/foreground_warning" />
        <TextView android:id="@+id/setupStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/sdkStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/rotationStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/rotation_warning" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <Button android:id="@+id/retrySetup" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/retry_setup" />
            <TextView android:id="@+id/permissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/requestPermission" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/notification_permission" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/accounts_title" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/accounts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/no_accounts" android:saveEnabled="false" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/refresh" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/add_title" android:textSize="20sp" android:textStyle="bold" />
        <EditText android:id="@+id/qrInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/qr_hint" android:inputType="textVisiblePassword|textMultiLine"
            android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="16384" />
        <Button android:id="@+id/registerQr" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/register_qr" />
        <EditText android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/code_hint" android:inputType="textVisiblePassword"
            android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="1024" />
        <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/url_hint" android:inputType="textVisiblePassword"
            android:importantForAutofill="no" android:saveEnabled="false" android:maxLength="4096" />
        <Button android:id="@+id/registerManual" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/register_manual" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/portal_demo_title" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/portal_demo_instructions" />
        <Button android:id="@+id/openEntraWebView" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/open_entra_webview" />
        <TextView android:id="@+id/portalStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:text="@string/portal_idle" />
        <Button android:id="@+id/showPortalStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/portal_show_status" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/controlled_page_title" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/controlled_page_preparation" />
        <Button android:id="@+id/openEmbeddedSetup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/open_embedded_setup" />
        <Button android:id="@+id/openBrowserSetup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/open_browser_setup" />
        <TextView android:id="@+id/pageStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:text="@string/no_setup_page" />
        <Button android:id="@+id/returnSetup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/return_setup" />
        <Button android:id="@+id/clearSetup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/clear_setup" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/challenge_title" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/challenges" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false" />
    </LinearLayout>
</ScrollView>
